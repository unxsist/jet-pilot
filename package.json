{
  "name": "jet-pilot",
  "private": true,
  "version": "1.38.0",
  "scripts": {
    "dev": "RUST_BACKTRACE=1 tauri dev",
    "build": "tauri build",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "analyze": "vite build --config vite.analyze.config.mts && node scripts/check-bundle-size.mjs --explain",
    "size:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest",
    "ts-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "harness": "vite --config dev/harness/vite.config.ts",
    "check": "cd src-tauri && cargo check",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@kubernetes-models/istio": "^2.3.0",
    "@kubernetes/client-node": "^2.0.0",
    "@radix-icons/vue": "^1.0.0",
    "@tanstack/vue-table": "^8.11.0",
    "@tanstack/vue-virtual": "^3.5.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@vee-validate/zod": "^4.12.5",
    "@vue-flow/core": "^1.42.1",
    "@vueuse/core": "^10.11.1",
    "ansi_up": "^6.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "culori": "^4.0.2",
    "date-fns": "^3.0.6",
    "dompurify": "^3.4.16",
    "embla-carousel-vue": "^8.3.0",
    "fast-plist": "^0.1.3",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.0",
    "jsonata": "^2.0.6",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.3.0",
    "lucide-vue-next": "^0.446.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.52.2",
    "monaco-yaml": "^5.5.1",
    "pluralize": "^8.0.0",
    "radix-vue": "^1.5.3",
    "tailwind-merge": "^2.1.0",
    "vee-validate": "^4.12.5",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.43",
    "vue-router": "^4.2.5",
    "vue3-lottie": "^3.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/git": "^11.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.2",
    "concurrently": "8.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.0.11",
    "postcss": "^8.5.28",
    "postcss-import": "15.1.0",
    "postcss-nesting": "12.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": ":rocket: This issue is resolved in version ${nextRelease.version} of JET Pilot!"
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
