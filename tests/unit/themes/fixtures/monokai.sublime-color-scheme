// A Monokai-style Sublime Text colour scheme (written for these tests), using
// variables, nested var() and the color() adjusters.
{
  "name": "Monokai Test",
  "author": "JET Pilot tests",
  "variables": {
    "black": "hsl(0, 0%, 0%)",
    "black2": "hsl(70, 8%, 15%)",
    "black3": "hsl(60, 17%, 11%)",
    "blue": "hsl(190, 81%, 67%)",
    "green": "hsl(80, 76%, 53%)",
    "orange": "hsl(32, 98%, 56%)",
    "purple": "hsl(261, 100%, 75%)",
    "red2": "hsl(338, 95%, 56%)",
    "white": "#ffffff",
    "white3": "hsl(60, 30%, 96%)",
    "yellow": "hsl(54, 70%, 68%)",
    "yellow5": "hsl(50, 11%, 41%)",
    "comment": "var(yellow5)",
    "keyword": "var(red2)",
    "line": "color(var(white3) alpha(0.06))",
    "dim": "color(var(white3) blend(var(black2) 40%))",
  },
  "globals": {
    "foreground": "var(white3)",
    "background": "var(black2)",
    "caret": "color(var(white) alpha(0.9))",
    "line_highlight": "var(line)",
    "selection": "hsl(56, 16%, 26%)",
    "gutter": "var(black2)",
    "gutter_foreground": "var(dim)",
    "invisibles": "color(var(white3) l(- 60%))",
    "accent": "var(blue)",
    "brackets_options": "underline",
    "shadow": "color(var(black) alpha(0.25))",
  },
  "rules": [
    { "name": "Comment", "scope": "comment", "foreground": "var(comment)" },
    { "name": "String", "scope": "string", "foreground": "var(yellow)" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "var(purple)" },
    { "name": "Built-in constant", "scope": "constant.language", "foreground": "var(purple)" },
    { "name": "Keyword", "scope": "keyword - (source.c keyword.operator)", "foreground": "var(keyword)" },
    { "name": "Tag name", "scope": "entity.name.tag", "foreground": "var(red2)" },
    { "name": "YAML key", "scope": "entity.name.tag.yaml", "foreground": "var(blue)" },
    { "name": "Punctuation", "scope": "punctuation.separator", "foreground": "color(var(white3) alpha(0.6))" },
    { "name": "Invalid", "scope": "invalid", "foreground": "color(var(red2) min-contrast(var(black2) 4.5))" },
  ],
}
